# -----------------------------------------------------------------------------
# AI Store Assistant — backend environment (sample)
# Copy to `.env` and adjust. Never commit real secrets.
#
# SECURITY:
#   - OPENAI_API_KEY / GEMINI_API_KEY / STORE_API_KEY stay ONLY here (server-side).
#   - The browser widget must never embed provider keys — only optional public API URL.
# -----------------------------------------------------------------------------

# --- App ---
APP_NAME=AI Store Assistant
DEBUG=false

# Comma-separated origins allowed to call this API from browsers (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8000

# --- Store integration ---
# mock = local JSON catalog (default). rest = call your Laravel/commerce API (implement RestStoreClient).
STORE_PROVIDER=mock
STORE_API_URL=
STORE_API_KEY=
STORE_API_TIMEOUT=10

# --- AI providers (all optional; leave blank for Mongolian rule-based fallback) ---
# Ollama (local): start Ollama, then set base URL + model name. Empty URL = skip Ollama.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# OpenAI: set API key to enable. Empty = skip.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini: set API key to enable. Empty = skip.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Limits ---
MAX_MESSAGE_LENGTH=1000

# --- Static widget (optional; Docker bind mount path for /widget) ---
FRONTEND_STATIC_PATH=
